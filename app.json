{
  "expo": {
    "name": "TescoERM",
    "slug": "TescoERM",
    "scheme": "tescoerm",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#2E8C2C",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#2E8C2C",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.tescodigitals26.tescoerm",
      "versionCode": 4,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tesco ERM tracks your location while you're checked in so HR can see your live work status. Tracking stops the moment you check out.",
        "NSLocationWhenInUseUsageDescription": "Tesco ERM uses your location to record office check-ins and verify field-work attendance.",
        "NSLocationAlwaysUsageDescription": "Tesco ERM keeps sharing your location with HR while you're checked in, even when the app is in the background."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "../../node_modules/react-native-background-fetch/android/libs"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tesco ERM shares your location with HR while you're checked in. Tracking stops automatically when you check out.",
          "locationAlwaysPermission": "Tesco ERM shares your location with HR while you're checked in, even when the app is closed. Tracking stops the moment you check out.",
          "locationWhenInUsePermission": "Tesco ERM uses your location to record check-ins and verify field-work attendance.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationForegroundServiceType": "location",
          "androidBackgroundPermissionRationale": "Tesco ERM needs Allow all the time so we can share your live location with HR between check-in and check-out. Without this, HR sees you as Offline within minutes of the app being backgrounded."
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "react-native-background-geolocation",
        {
          "license": "eyJhbGciOiJFZERTQSIsImtpZCI6ImVkMjU1MTktbWFpbi12MSJ9..DutcWsl8JSUzAfwoPWhbNh-hOiZ_o2VN2het6PzWF06uGLkUYWbP3cS7u0FzTpvjRJedO2ZcDXcmTJUHQLqJCw"
        }
      ],
      "react-native-background-fetch",
      "./plugins/withPlayServicesLocationPin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0ab10fe-ab6e-4dc7-ae0f-094326f261ab"
      }
    },
    "owner": "tescoerm"
  }
}
